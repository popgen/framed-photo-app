# Copy to .env. Never commit .env.
# Public values are inlined into the web bundle. Anything without EXPO_PUBLIC_ stays on the server.

# local = full shop in the browser with seed data (default when these are empty)
# supabase = check the project, and use Supabase Auth for admin
EXPO_PUBLIC_DATA_MODE=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# mock (default) approves Yape, Plin, and card in a sandbox sheet on this browser
# live asks the server to open Izipay (or Stripe if PAYMENT_PROVIDER=stripe)
EXPO_PUBLIC_PAYMENTS_MODE=mock
EXPO_PUBLIC_NOTIFY_MODE=mock

# Public site URL baked into links. Production is https://mifotito.com.
# For local links in WhatsApp messages, set http://localhost:8081.
EXPO_PUBLIC_SITE_URL=https://mifotito.com
# Vacío. La tienda no abre WhatsApp y este valor no debe ser un número de relleno.
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Seasonal motion. Leave empty to follow the campaign file. false turns the ornaments off.
EXPO_PUBLIC_SEASONAL_MOTION=

# Countdown clock. Leave empty to follow campaign.countdownStartsAt. true forces it on, false forces it off.
EXPO_PUBLIC_COUNTDOWN=

# Stock badges and order blocks. Leave unset (off). Set both to true, then redeploy, to enforce stock again.
# EXPO_PUBLIC_ is baked into the web build. STOCK_CHECKS_ENABLED is read by the Netlify functions.
EXPO_PUBLIC_STOCK_CHECKS_ENABLED=
STOCK_CHECKS_ENABLED=

# Photo imports stay hidden until the flag is true AND the public id is set.
EXPO_PUBLIC_ENABLE_INSTAGRAM=false
EXPO_PUBLIC_ENABLE_FACEBOOK=false
EXPO_PUBLIC_ENABLE_GOOGLE_PHOTOS=false
EXPO_PUBLIC_IMPORT_SANDBOX=false
EXPO_PUBLIC_META_APP_ID=
EXPO_PUBLIC_GOOGLE_PHOTOS_CLIENT_ID=

# Local demo admin. Ignored when DATA_MODE=supabase.
EXPO_PUBLIC_DEMO_ADMIN_EMAIL=admin@mifotito.pe
EXPO_PUBLIC_DEMO_ADMIN_PASSWORD=recuerdo-demo

# ----- server only (Vercel/Netlify functions, never EXPO_PUBLIC_) -----
SUPABASE_SERVICE_ROLE_KEY=
# Correo de «tu pedido va en camino». Zoho: smtp.zoho.com, puerto 465, SSL.
# SMTP_FROM es el remitente, por ejemplo: Mi Fotito <pedidos@mifotito.com>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mi Fotito <pedidos@mifotito.com>
PAYMENTS_MODE=mock
# empty = Izipay when its four keys exist. stripe = US Stripe account charging PEN.
PAYMENT_PROVIDER=
PAYMENT_MOCK_SECRET=
NOTIFY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago Checkout Pro (Peru), beside Izipay. Server only.
# The checkout shows it only when PAYMENTS_MODE=live and both the token and the webhook secret are set.
# The public key is unused: Checkout Pro does not run in the browser.
# Webhook: https://mifotito.com/api/payments/mercadopago-webhook
# Instant payout (3.49% + S/ 1 + IGV) is a Mercado Pago account setting. Do not surcharge the customer.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
YAPE_PHONE=
PLIN_PHONE=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# WhatsApp Business is pending. Leave the four values below empty in Netlify.
# Tracking then uses the email on the order, or a wa.me support link.
# Set WHATSAPP_OTP_ENABLED=true only after Meta approves the template.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=
# Unused by customer login. Optional cookie secret for photo import. Empty is fine.
OTP_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
META_APP_ID=
META_APP_SECRET=
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
SITE_URL=https://mifotito.com

# Izipay (card and Yape). Leave empty to keep live card payments unconfigured.
# Test and production use the same CreatePayment URL; the keys decide the environment.
# IPN to register: https://mifotito.com/api/payments/izipay-ipn
# Stripe webhook, only if PAYMENT_PROVIDER=stripe: https://mifotito.com/api/payments/stripe-webhook
IZIPAY_COMMERCE_ID=
IZIPAY_API_KEY=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=
IZIPAY_ENV=sandbox
