{
  "expo": {
    "name": "Recuerdo",
    "slug": "recuerdo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "recuerdo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.recuerdo.app"
    },
    "android": {
      "package": "pe.recuerdo.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Recuerdo usa tus fotos para imprimirlas dentro del marco."
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "brand": "Recuerdo"
    }
  }
}
